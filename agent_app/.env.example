# 复制成 .env 再填你自己的值：copy .env.example .env
# .env 已在 .gitignore 里，不会被提交

# ===== 必填（没有默认值，不填会启动报错）=====
# 从 https://platform.deepseek.com 控制台获取
DEEPSEEK_API_KEY=sk-your-key-here


# ===== 以下都可选（不填就用 config.py 里的默认值）=====

# 数据库连接串。默认指向 infra/docker-compose.yml 起的本地副本库。
# W2 开始才用到，W1 不用填。
# PG_DSN=postgresql://agent:agent_dev_pw@localhost:55432/tpch

# 日志级别：DEBUG / INFO / WARNING / ERROR
# LOG_LEVEL=INFO

# 模型：deepseek-flash（默认）或 deepseek-v4-pro
# MODEL=deepseek-flash

# 单次调用大模型的超时（秒）
# LLM_TIMEOUT=30.0
