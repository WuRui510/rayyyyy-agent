# ============================================
# 仓库根 .gitignore —— 覆盖所有周项目
# ============================================

# ---- 敏感信息（绝对不能提交！）----
.env
*.env
!.env.example

# ---- 个人笔记（不公开）----
开发笔记.md

# ---- Python 编译产物 ----
__pycache__/
*.py[cod]
*$py.class

# ---- 虚拟环境 ----
.venv/
venv/
env/

# ---- 调试 / 探针脚本 ----
_test/

# ---- 日志与临时文件 ----
*.log
*.tmp

# ---- 编辑器 / 系统生成 ----
.idea/
.vscode/
.DS_Store
Thumbs.db
